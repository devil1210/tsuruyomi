# ==============================================================================
# Tsuruyomi Environment Configuration (.env)
# ==============================================================================
# All variables below have sensible defaults in docker-compose.yml.
# Copy this file to .env and customize any values you wish to change.

# --- Web Server ---
# SERVER_PORT=7654
# TZ=America/Santiago

# --- Database Connection ---
# Option 1: Individual parameters (recommended for multi-app docker compose stacks)
# DBUSER=tsuruyomi
# DBPASS=tsuruyomi_pass
# DBHOST=postgres
# DBPORT=5432
# DBNAME=tsuruyomi

# Option 2: Full connection string (overrides individual DB* variables if set)
# DATABASE_DSN=postgres://tsuruyomi:tsuruyomi_pass@postgres:5432/tsuruyomi?sslmode=disable

# --- Optional Integrations ---
# SIDECAR_ENABLED=false
# SIDECAR_BASE_URL=http://tsuruyomi-sidecar:4568
# FLARESOLVERR_ENABLED=false
# FLARESOLVERR_URL=http://flaresolverr:8191
